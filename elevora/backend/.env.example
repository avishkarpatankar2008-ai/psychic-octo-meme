# Copy this file to .env and fill in real values. Never commit the real .env.

ENV=development

# MongoDB Atlas connection string (or local mongodb://localhost:27017)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=elevora

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Must match the frontend origin exactly (no trailing slash) for cookies + CORS to work
FRONTEND_ORIGIN=http://localhost:3000

COOKIE_NAME=elevora_session
# "none" is required if frontend/backend are on different domains in production (requires https)
COOKIE_SAMESITE=lax

# Phase 2: AI interview engine. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phase 3: voice (speech-to-text / text-to-speech)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
